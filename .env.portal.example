# Copy to /var/lib/vybertron-portal/portal.env on the host with mode 600; never commit real secrets.
# Supply both --env-file /root/Vybertron/.env and --env-file /var/lib/vybertron-portal/portal.env to Docker Compose.
# CLIENT_ID and the bot/audio credentials stay in the existing private .env.
PORTAL_ORIGIN=https://vybatron.YOUR-TAILNET.ts.net
# Discord Developer Portal -> Vybatron -> OAuth2 -> Client secret.
# Register exactly ${PORTAL_ORIGIN}/auth/discord/callback in Redirects.
DISCORD_CLIENT_SECRET=
# Generate these independently on the host using Python secrets.token_urlsafe(48).
PORTAL_BRIDGE_TOKEN=
PORTAL_SESSION_SECRET=
