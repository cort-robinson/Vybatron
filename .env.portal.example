# Copy to .env.portal on the VPS with mode 600; never commit real secrets.
# Supply both --env-file .env and --env-file .env.portal to Docker Compose.
# CLIENT_ID and the bot/audio credentials stay in the existing private .env.
PORTAL_ORIGIN=https://vybertron.YOUR-TAILNET.ts.net
# Discord Developer Portal -> Vybatron -> OAuth2 -> Client secret.
# Register exactly ${PORTAL_ORIGIN}/auth/discord/callback in Redirects.
DISCORD_CLIENT_SECRET=
# Generate these independently on the VPS using Python secrets.token_urlsafe(48).
PORTAL_BRIDGE_TOKEN=
PORTAL_SESSION_SECRET=
