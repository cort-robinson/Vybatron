[Unit]
Description=Vybertron playback checks and tested recovery
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Vybertron
ExecStart=/usr/bin/python3 /root/Vybertron/ops/recovery.py run
Environment=PYTHONUNBUFFERED=1
UMask=0077
TimeoutStartSec=15min
