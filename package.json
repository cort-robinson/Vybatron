{
  "name": "vybatron",
  "version": "2.1.0",
  "description": "Discord music bot powered by Lavalink",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "deploy:commands:guild": "node deploy-commands.js guild",
    "deploy:commands:global": "node deploy-commands.js",
    "test": "node --test tests/*.test.js",
    "portal:build": "npm --prefix portal/web run build",
    "portal:test": "npm --prefix portal/server test",
    "portal:integration": "node --test portal/integration/*.test.js",
    "portal:dev": "npm --prefix portal/web run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cort-robinson/Vybatron.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cort-robinson/Vybatron/issues"
  },
  "homepage": "https://github.com/cort-robinson/Vybatron#readme",
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "18.0.7",
    "lavalink-client": "2.11.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
