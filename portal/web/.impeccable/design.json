  "narrative": {
    "northStar": "Aurora Queue and Luminous Sleeve",
    "overview": "Aurora Queue and Luminous Sleeve are complementary expressions of one private listening space. Midnight navy carries open, legible rows; cyan makes control easy to find, magenta marks personal favorites, and amber makes pause and recovery understandable.\n\nReal current-track artwork creates a localized, softened atmosphere around the expanded sleeve. The persistent player survives navigation and transforms between compact and expanded composition. Audio stays in Discord; decorative movement never implies measured sound or beat synchronization.",
    "keyCharacteristics": [
      "Open rows and quiet tonal separation.",
      "One current-track identity, timeline, and control cluster.",
      "Real artwork, restrained luminous depth, and familiar Phosphor icons.",
      "Desktop and portrait phone compositions with explicit permission and connection states."
    ],
    "rules": [
      {
        "name": "The State Color Rule",
        "body": "Cyan denotes actions and selected controls; magenta denotes favorites; amber denotes Warm, pause, and recovery. Pair status color with readable text or a familiar icon.",
        "section": "colors"
      },
      {
        "name": "The Single Identity Rule",
        "body": "Render the current song once per player state, beside its favorite action when that action is visible. Expansion transforms the existing player rather than creating another now-playing strip.",
        "section": "typography"
      },
      {
        "name": "The Artwork Atmosphere Rule",
        "body": "Tint the expanded sleeve with its actual current artwork. Keep atmosphere behind content, localized around the cover, and independent of playback authority.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the single player across Session, My Music, and Server navigation.",
      "Do use server-projected capabilities and fresh state to decide whether an action is available.",
      "Do retain inputs and show useful recovery, conflict, offline, empty, and error messages.",
      "Do use source artwork with the bundled fallback and one coherent Phosphor icon family.",
      "Do settle ambient motion on pause, recovery, disconnection, hidden tabs, and reduced motion."
    ],
    "donts": [
      "Don't introduce browser audio, measured spectrum, amplitude, or beat-sync claims.",
      "Don't use client display names, roles, or voice assumptions as permission authority.",
      "Don't replay an uncertain or stale mutation after reconnect.",
      "Don't duplicate current identity, timeline, or transport between compact and expanded states.",
      "Don't make bright accent washes compete with track text or disabled-state explanations."
    ]
  }
}
